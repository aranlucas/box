{
  "name": "box",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "prepare": "husky",
    "check:pr-title": "commitlint",
    "lint": "pnpm --filter @box/worker types && oxlint --deny-warnings",
    "lint:fix": "pnpm lint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test",
    "build:web": "pnpm --filter @box/app export:web",
    "deploy": "pnpm build:web && pnpm --filter @box/worker exec cf deploy --secrets-file .dev.vars"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "eslint-import-resolver-typescript": "3.10.1",
    "eslint-plugin-expo": "1.2.1",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "husky": "9.1.7",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "oxlint-config-universe": "0.2.0",
    "oxlint-tsgolint": "7.0.2007",
    "typescript": "~6.0.3"
  }
}
