{
  "expo": {
    "name": "Boxes",
    "slug": "moving-boxes",
    "version": "1.4.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "boxes",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#23443A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "dev.movingjourney.boxes",
      "permissions": ["android.permission.CAMERA"],
      "versionCode": 6
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "Boxes",
      "shortName": "Boxes",
      "themeColor": "#F3EDE3",
      "backgroundColor": "#F3EDE3"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F3EDE3",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Take photos of what is inside each box.",
          "photosPermission": "Choose photos of what is inside each box.",
          "microphonePermission": false
        }
      ],
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "neverForLocation": true
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
